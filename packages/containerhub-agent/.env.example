CONTAINERHUB_AGENT_PORT=9997
CONTAINERHUB_AGENT_SERVER_NAME=containerhub-agent
CONTAINERHUB_AGENT_CA_FILE=/run/secrets/containerhub-agent-ca.pem
CONTAINERHUB_AGENT_SERVER_CERT_FILE=/run/secrets/containerhub-agent-server-cert.pem
CONTAINERHUB_AGENT_SERVER_KEY_FILE=/run/secrets/containerhub-agent-server-key.pem
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_DATA_PATH=/var/lib/containerhub
# Optional comma-separated absolute host roots. Keep this identical to app and mount each root in this agent.
# CONTAINERHUB_HOST_VOLUME_ROOTS=/storage,/logs,/localdata
NODE_ID=
