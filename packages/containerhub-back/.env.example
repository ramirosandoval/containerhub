# Required Drax database configuration. Use DRAX_SQLITE_FILE instead of
# DRAX_MONGO_URI only when DRAX_DB_ENGINE=sqlite.
DRAX_DB_ENGINE=mongo
DRAX_MONGO_URI=mongodb://127.0.0.1:27017/incartainer
# DRAX_SQLITE_FILE=containerhub.db

# Required. Generate a unique secret for each environment; there is no fallback.
DRAX_JWT_SECRET=super_secret
# Optional Drax JWT settings (shown with Drax runtime defaults).
DRAX_JWT_EXPIRATION=1d
DRAX_JWT_ISSUER=drax
DRAX_DEFAULT_ROLE=Soporte

# MEDIA
DRAX_AVATAR_DIR=avatar
DRAX_FILE_DIR=media
DRAX_BASE_URL=http://localhost:9998

# EMAIL CONFIGURATION (SMTP)
EMAIL_TYPE=SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_AUTH_USERNAME=your_email@gmail.com
EMAIL_AUTH_PASSWORD=your_password

# Disabled by default. Set to true only for initial user creation, provide all
# five values below, then disable it after the first successful startup.
CONTAINERHUB_BOOTSTRAP_ENABLED=false
# CONTAINERHUB_BOOTSTRAP_NAME=
# CONTAINERHUB_BOOTSTRAP_USERNAME=
# CONTAINERHUB_BOOTSTRAP_PASSWORD=
# CONTAINERHUB_BOOTSTRAP_EMAIL=
# CONTAINERHUB_BOOTSTRAP_PHONE=

DRAX_PORT=9998
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Required in production. Exact browser origin allowed to open terminal WebSockets.
# TERMINAL_ALLOWED_ORIGIN=https://containerhub.example.com
# Optional node-agent transport. Configure all three mTLS files to enable it.
# CONTAINERHUB_AGENT_CA_FILE=/run/secrets/containerhub-agent-ca.pem
# CONTAINERHUB_AGENT_CLIENT_CERT_FILE=/run/secrets/containerhub-agent-client-cert.pem
# CONTAINERHUB_AGENT_CLIENT_KEY_FILE=/run/secrets/containerhub-agent-client-key.pem
# CONTAINERHUB_AGENT_HOST=containerhub-agent
# CONTAINERHUB_AGENT_SERVER_NAME=containerhub-agent
# CONTAINERHUB_AGENT_PORT=9997
NODE_ENV=development
GITLAB_URL=https://gitlab.example.internal/api/v4
GITLAB_TOKEN=replace-with-read-only-api-token
REGISTRY_URL=https://registry.example.internal/v2/
DOCKER_DATA_PATH=/var/lib/containerhub
